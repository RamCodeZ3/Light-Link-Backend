{
  "name": "light-link-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "data:prepare": "python3 scripts/prepare_data.py",
    "test:live": "tsx scripts/smoke-automatic-sites.ts",
    "test:python": ".venv/bin/python -m unittest discover -s tests/python -v"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
